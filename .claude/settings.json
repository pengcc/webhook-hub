{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh pr create*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin docs/*)"
    ],
    "ask": ["Bash(git push)", "Bash(gh repo create*)", "Bash(gh pr merge*)"],
    "deny": [
      "mcp__plugin_github_github__create_pull_request",
      "mcp__plugin_github_github__update_pull_request",
      "mcp__plugin_github_github__update_pull_request_branch",
      "mcp__plugin_github_github__merge_pull_request",
      "mcp__ccd_pr__set_auto_merge",
      "Bash(git -* push*)",
      "Bash(git push* --force*)",
      "Bash(git push* -f *)",
      "Bash(git push* -f)",
      "Bash(git push* -d *)",
      "Bash(git push* --delete*)",
      "Bash(git push* --mirror*)",
      "Bash(git push* --all*)",
      "Bash(git push* --tags*)",
      "Bash(git push*:*)",
      "Bash(git push* +*)",
      "Bash(git push* refs/*)",
      "Bash(git push* main)",
      "Bash(git push* main *)",
      "Bash(git push* origin feat/* *)",
      "Bash(git push* origin fix/* *)",
      "Bash(git push* origin chore/* *)",
      "Bash(git push* origin docs/* *)"
    ]
  }
}
