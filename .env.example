# Placeholders only. Real values live in the VPS .env and never enter the repo.
# The database password goes in PGPASSWORD (read by pg), not in the URL.
DATABASE_URL=postgres://webhook_hub@postgres:5432/webhook_hub
PGPASSWORD=<database-password>
SHOPIFY_WEBHOOK_SECRET=<shopify-webhook-secret>
PORT=3000
# Optional worker settings (defaults shown)
# WORKER_ENABLED=true
# WORKER_POLL_MS=1000
# WORKER_BATCH_SIZE=10
# WORKER_MAX_ATTEMPTS=12
# WORKER_LOCK_TIMEOUT_SECONDS=300
# WORKER_HANDLER_TIMEOUT_SECONDS=60
# Read API protection. CORS_ALLOWED_ORIGINS takes origins without a path.
# Set TRUST_PROXY=true only behind a reverse proxy that overwrites X-Forwarded-For.
# CORS_ALLOWED_ORIGINS=https://<your-dashboard-origin>
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_SECONDS=60
# TRUST_PROXY=false
