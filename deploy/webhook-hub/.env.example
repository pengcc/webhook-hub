# Placeholders only. The real file is /opt/webhook-hub/deploy/webhook-hub/.env on
# the VPS (mode 600) and never enters the repository.

# The same value as WEBHOOK_HUB_DB_PASSWORD in ../infra/.env.
WEBHOOK_HUB_DB_PASSWORD=<webhook-hub-database-password>

# The secret Shopify signs deliveries with. Until there is a Shopify store, use
# a random test value for simulated deliveries.
SHOPIFY_WEBHOOK_SECRET=<shopify-webhook-secret>

# Optional: origin(s) of the dashboard, comma separated, without a path.
# CORS_ALLOWED_ORIGINS=https://<your-dashboard-origin>
