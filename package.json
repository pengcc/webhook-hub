{
  "name": "webhook-hub",
  "version": "0.0.0",
  "description": "Webhook receiver with signature verification, idempotent ingestion, retries and a read-only dashboard API",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "safety:guard": "node .repo-tools/scripts/safety-guard.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:up": "docker compose up -d postgres --wait",
    "test:repo-tools": "node --test \".repo-tools/scripts/**/*.test.mjs\"",
    "test:service": "vitest run",
    "test": "pnpm test:repo-tools && pnpm test:service"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.26.0 <12"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.3.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
